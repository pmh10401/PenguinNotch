{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PenguinNotch",
  "version": "1.18.10",
  "identifier": "com.pmh10401.penguinnotch",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "notch",
        "url": "notch.html",
        "width": 340,
        "height": 460,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/pmh10401/PenguinNotch/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDQzA3RjM0Mzg1Q0I5REYKUldUZnVWdzROSC9BckFRTUJTMGQxcGp3TFdzdWRUV24rWFlYS1VDaVB1S0JjYXZQbU1rU2p0ZFUK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
